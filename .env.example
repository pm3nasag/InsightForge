# Copy to .env and fill in.  Nothing here is mandatory: the Streamlit app also
# takes a key from its sidebar, and with no key at all it runs offline.

# --- OpenRouter (the provider used by this project) ------------------------
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
CHAT_MODEL=openai/gpt-4o-mini

# --- optional alternatives -------------------------------------------------
# OPENAI_API_KEY=sk-...            # also unlocks API embeddings
# GOOGLE_API_KEY=...
# EMBEDDING_MODEL=text-embedding-3-small

# --- behaviour -------------------------------------------------------------
# LLM_PROVIDER=auto                # auto | openrouter | openai | google | offline
# TEMPERATURE=0.1
# MAX_TOKENS=900
